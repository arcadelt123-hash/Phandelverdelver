[["  const scrollBox = inner => `<div style=\"margin:4px -4px;padding:54px 44px 40px 50px;min-height:160px;background-image:url(${SCR_BG});background-size:100% 100%;background-repeat:no-repeat;color:#2b1d0e;font-family:${T.font};font-size:13px;line-height:1.5;word-break:keep-all;\">${inner}</div>`;", "  const scrollBox = inner => line('', inner, SBC);   // v2.9.1: 두루마리 그림 없이 — 갈색 줄 카드 (미리보기와 같게)"], ["  const icoBtn = (src, cmd, title, after) => `<a href=\"${cmd}\" title=\"${title}\" style=\"display:inline-block;background-color:transparent;background:none;border:0;padding:0 2px;margin:0 2px;vertical-align:middle;box-shadow:none;\"><img src=\"${src}\" alt=\"${title}\" style=\"width:30px;height:30px;vertical-align:middle;\">${after ? `<span style=\"color:#2b1d0e;font-size:11px;\">${after}</span>` : ''}</a>`;", "  const icoBtn = (src, cmd, title, after) => midiBtn('대상 지정', cmd) + (after ? ` <span style=\"font-size:11px;\">${after}</span>` : '');   // v2.9.1: 과녁 그림 대신 [대상 지정] 버튼"]]